{
    "name": "wapplersystems/core-upgrader",
    "type": "typo3-cms-extension",
    "description": "Run upgrade wizards for multiple TYPO3 versions at once and clean up the system",
    "keywords": ["TYPO3 CMS", "Extension", "Upgrade", "Update", "Wizards", "maintenance", "cleanup"],
    "homepage": "https://github.com/WapplerSystems/core_upgrader",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer"
        },
        {
            "name": "Nicole Cordes",
            "email": "typo3@cordes.co",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/WapplerSystems/core_upgrader",
        "issues": "https://github.com/WapplerSystems/core_upgrader/issues"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.0",
        "typo3/cms-install": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\Upgrader\\": "Classes/",
            "TYPO3\\CMS\\v76\\Core\\Upgrades\\": "Classes/Upgrades/v76/",
            "TYPO3\\CMS\\v87\\Core\\Upgrades\\": "Classes/Upgrades/v87/",
            "TYPO3\\CMS\\v95\\Core\\Upgrades\\": "Classes/Upgrades/v95/",
            "TYPO3\\CMS\\v104\\Core\\Upgrades\\": "Classes/Upgrades/v104/",
            "TYPO3\\CMS\\v11\\Core\\Upgrades\\": "Classes/Upgrades/v11/",
            "TYPO3\\CMS\\v12\\Core\\Upgrades\\": "Classes/Upgrades/v12/",
            "TYPO3\\CMS\\v13\\Core\\Upgrades\\": "Classes/Upgrades/v13/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "core_upgrader2"
        }
    }
}